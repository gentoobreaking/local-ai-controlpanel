# Agent Control Plane - 環境變數範例
# 複製為 .env 並填入實際值（切勿 commit .env 到 git）

# =============================================================================
# Control Plane 基礎設定
# =============================================================================
CP_HOST=127.0.0.1
CP_PORT=3001
CP_DATA_DIR=./.acp-data
CP_POLICIES_DIR=./policies

# =============================================================================
# Pi Worker / 本地推理引擎
# =============================================================================
# llama.cpp 預設 endpoint（§16）
LLAMA_BASE_URL=http://127.0.0.1:8080
LLAMA_MODEL=qwen2.5-coder:7b
LLAMA_TIMEOUT_MS=300000

# 可選：改用 ollama
# LLAMA_BASE_URL=http://127.0.0.1:11434
# LLAMA_MODEL=qwen2.5-coder:7b

# =============================================================================
# Phase / Hybrid Execution / Cloud 設定 (T035, Phase 9+)
# =============================================================================

# Phase 設定：1-5 (local_only) | 6-8 (local_only + MCP/ACP) | 9+ (Hybrid/Cloud)
CP_PHASE=9

# 是否允許 Cloud（Phase 9+ 才生效）
CP_ALLOW_CLOUD=1

# Cloud Provider 選擇：anthropic | openai | gemini
CP_CLOUD_PROVIDER=anthropic

# Cloud Provider API Keys（至少需一組；可同時設多組，Manager 會自動註冊）
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# 可選：自訂 OpenAI-compatible endpoint（支援 OpenCode Zen、vLLM、Ollama、vLLM 等）
# OPENAI_BASE_URL=https://api.opencode.ai/v1
# OPENAI_API_KEY=<opencode_zen_key>

# Cloud 模型配置（預設已內建，環境變數優先）
CP_CLOUD_MODEL_REVIEWER=claude-3.5-sonnet
CP_CLOUD_MODEL_PLANNER=claude-3.5-sonnet
CP_CLOUD_MODEL_EXECUTOR=gpt-4o

# 成本控制
CP_MAX_DAILY_COST_USD=50.0
CP_MAX_TOKENS_PER_TASK=100000

# =============================================================================
# MCP / ACP 協議層 (T034, Phase 6+)
# =============================================================================
CP_MCP_ENABLED=0
CP_ACP_ENABLED=0
CP_MCP_WORKSPACE=/absolute/path/to/workspace

# =============================================================================
# Verification / Sandbox
# =============================================================================
CP_SEATBELT_PROFILE=./sandbox-profiles/verification-default.sb

# =============================================================================
# OpenCode Zen 支援（可選）
# =============================================================================
# 方式 1：用 OpenAI Provider + 自訂 baseUrl
# OPENAI_API_KEY=<opencode_zen_key>
# OPENAI_BASE_URL=https://api.opencode.ai/v1
# CP_CLOUD_PROVIDER=openai

# =============================================================================
# 前端 / Tauri
# =============================================================================
ACP_CP_PORT=3001
ACP_CP_NODE=node
ACP_CP_PATH=./apps/control-plane/dist/main.js
ACP_CP_AUTOSTART=1
ACP_CP_DATA_DIR=./.acp-data
# =============================================================================
# Agentic 搜尋迴圈 / Web Research（2026-08 新增）
# =============================================================================
# IMPLEMENTING 前讓模型自評證據缺口並迭代上網查詢（關閉則為單發生成）
CP_AGENTIC_SEARCH=1
# 搜尋迴圈硬上限（防無限燒 token）
CP_MAX_SEARCH_ROUNDS=10
# GitHub MCP（repo search、README；gh auth token 可取得）
GITHUB_TOKEN=
CP_MCP_GITHUB_ENABLED=1
# Scrapling MCP（網頁 → Markdown；pip install "scrapling[ai]" && scrapling install）
CP_MCP_SCRAPLING_ENABLED=0
