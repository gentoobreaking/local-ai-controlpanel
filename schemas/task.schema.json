  "$id": "task.schema.json",
  "title": "Task",
  "description": "Core Domain Model：Task（spec §8）",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "userRequest": { "type": "string" },
    "status": { "type": "string" },
