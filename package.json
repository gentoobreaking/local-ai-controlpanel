{
  "name": "acp-desktop",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "pnpm -r typecheck",
    "cp:dev": "pnpm --filter @acp/control-plane dev",
    "cp:build": "pnpm --filter @acp/control-plane build",
    "cp:test": "pnpm --filter @acp/control-plane test",
    "acp": "pnpm --filter @acp/cli exec tsx src/main.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
