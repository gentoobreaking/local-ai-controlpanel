{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Control Plane",
  "version": "0.5.0",
  "identifier": "ai.controlplane.acp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "BUILD_ENV=development NODE_ENV=development pnpm build && BUILD_ENV=development NODE_ENV=development pnpm cp:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Control Plane",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 500,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "../apps/control-plane/dist-bundle/dist": "control-plane/dist",
      "../apps/control-plane/dist-bundle/node_modules": "control-plane/node_modules",
      "../policies": "policies",
      "../sandbox-profiles": "sandbox-profiles"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
