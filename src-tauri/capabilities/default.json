{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "最小權限（spec §45.3）：只有網路(本機 Control Plane)、clipboard、window；無 filesystem / shell / secrets",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    }
  ]
}
